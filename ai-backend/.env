# 真实密钥只放在本文件（.env 已被 .gitignore 忽略，切勿提交）
DEEPSEEK_API_KEY=sk-04e2a51c5633482e8668090e27e04ff4
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型 ID：deepseek-flash（V4 Flash）/ deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# true = 全部走预制黄金路径数据（断网/演示保险）；false = 真实调用 DeepSeek
MOCK_MODE=false
# 真实调用失败（含余额不足/超时）时是否自动降级到 mock，建议演示期间保持 true
LLM_FALLBACK_TO_MOCK=true
DATA_DIR=data
# 监听地址：127.0.0.1 = 仅本机（默认）。手机/其他设备要连进来改成 0.0.0.0
# 并务必同时设置下面的 API_TOKEN。
HOST=127.0.0.1
PORT=8000
# 路演时建议改成 false，避免文件变动触发重启打断演示
RELOAD=true
# 允许的前端来源，逗号分隔；`*` 表示全部（此时 allow_credentials 自动关闭）
CORS_ORIGINS=*
# 可选鉴权：留空 = 不校验（仅本地演示）。公网暴露前设为随机串，
# 设置后 /api/* 需带请求头 X-API-Token: <值>，/health 与 /docs 不受影响。
API_TOKEN=
# 成本防护：每日 LLM 调用上限（超出自动降级 mock，不中断服务）；0 = 不限
LLM_DAILY_CALL_LIMIT=300
# 成本防护：单 IP 每分钟请求上限；0 = 不限
RATE_LIMIT_PER_MINUTE=120

# ---------- 向量 RAG ----------
# hybrid（BM25+向量融合，默认）/ vector / bm25
RAG_MODE=hybrid
# api：硅基流动真语义检索（免费 BGE，2026-09 注册赠送额度）
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xzaltqofxjymtddtfvwssxvdnkczfpkfgczppzrmiumixxcp
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
