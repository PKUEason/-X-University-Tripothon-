DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MOCK_MODE=false
LLM_FALLBACK_TO_MOCK=true
DATA_DIR=data

# 监听地址。127.0.0.1 = 仅本机可访问（默认，最安全）。
# 手机 / 其他设备要连进来，改成 0.0.0.0，并务必同时设置下面的 API_TOKEN。
HOST=127.0.0.1
PORT=8000
# 路演时建议关掉热重载，避免文件变动触发重启打断演示
RELOAD=true

# 允许的前端来源，逗号分隔；`*` 表示全部。
# 注意：填 `*` 时会自动关闭 allow_credentials（规范要求二者互斥）。
CORS_ORIGINS=*

# 可选鉴权。留空 = 不校验，仅适合本地演示。
# 一旦要把服务暴露到公网（ngrok / 云主机 / 评委扫码体验），请设置一个随机串：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 设置后所有 /api/* 请求需携带请求头 X-API-Token: <值>（或 Authorization: Bearer <值>）。
# /health 与 /docs 不受影响。
API_TOKEN=

# 成本防护（公网暴露时的刹车）
# 每日真实 LLM 调用上限。超出后自动降级到 MOCK 黄金路径——服务不中断，只是不再花钱。
# 0 = 不限制。按一次演示约 10 次调用估算，300 次够跑 30 场。
LLM_DAILY_CALL_LIMIT=300
# 单 IP 每分钟请求上限，超出返回 429。0 = 不限制。
# 注意走隧道时所有用户共享一个来源 IP，等于全局限流，别调太小。
RATE_LIMIT_PER_MINUTE=120

# ---------- 向量 RAG（第二阶段升级） ----------
# 检索模式：hybrid（BM25+向量 RRF 融合，默认）/ vector（仅向量）/ bm25（仅关键词）
RAG_MODE=hybrid
# Embedding 后端：
#   auto     默认。配了 EMBEDDING_BASE_URL 就走 API；装了 fastembed 就走本地；否则哈希兜底
#   api      OpenAI 兼容 /embeddings 端点（需配下面三项）
#   fastembed 本地 ONNX 模型（需 pip install -r requirements-rag.txt，离线可跑）
#   hash     零依赖确定性哈希（无语义，测试/兜底用）
#   none     关闭向量路
EMBEDDING_PROVIDER=auto
# 硅基流动（免费 BGE，推荐，注册即送额度）：
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_MODEL=BAAI/bge-m3
# OpenAI：EMBEDDING_BASE_URL=https://api.openai.com/v1，EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 本地 fastembed 模型（仅 EMBEDDING_PROVIDER=fastembed）
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ---------- arXiv 实时检索（Library 相关论文区） ----------
# 免费、无需 key；失败自动降级，不影响本地资料。
ARXIV_ENABLED=true
# 单次请求超时（秒）。路演网络不稳时调小，避免 Library 卡住。
ARXIV_TIMEOUT=8.0
# 每次返回论文数。
ARXIV_TOP_K=3

# ---------- 联网搜索（Library 网页结果区，Bing RSS 默认） ----------
# 免费、无需 key，国内直连 cn.bing.com；失败自动降级，不影响本地资料和 arXiv。
WEB_SEARCH_ENABLED=true
# auto / bing / tavily / mock。auto 默认 Bing RSS；配了 TAVILY_API_KEY 可显式选 tavily。
WEB_SEARCH_PROVIDER=auto
# 单次请求超时（秒）。
WEB_SEARCH_TIMEOUT=10.0
# 每次返回网页结果数。
WEB_SEARCH_MAX_RESULTS=6
# Tavily API Key（可选，免费 1000 次/月）。不填则用 Bing RSS。
TAVILY_API_KEY=
