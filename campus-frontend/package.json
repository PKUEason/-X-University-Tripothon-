{
  "name": "x-university-campus",
  "private": true,
  "type": "module",
  "scripts": {
    "sdk": "node build.mjs --sdk",
    "start": "npm run sdk && node server.mjs",
    "build": "node build.mjs",
    "test": "npm run sdk && node --test tests/*.test.js",
    "dev": "npm run sdk && node scripts/dev.mjs",
    "dev:background": "npm run sdk && node scripts/background.mjs start",
    "dev:status": "node scripts/background.mjs status",
    "dev:stop": "node scripts/background.mjs stop"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "marked": "18.0.14"
  }
}
